# Pexels image/video search (optional).
# Without it, the source picker degrades gracefully to upload + the bundled gallery.
# Get a free key at https://www.pexels.com/api/
#   - Local dev: copy to .env.local and set the value.
#   - Production: set in Vercel → Project → Settings → Environment Variables
#     (Production + Preview) as a plain server-side var (NOT NEXT_PUBLIC_).
#     The /api/pexels route proxies with this key, so search works for every
#     visitor with no personal key required.
PEXELS_API_KEY=
